/* Prismatic: shared geometry and hierarchy, faction colors supplied by UIThemes. */
.rr-ui .prism-surface { background-color: rgba(0,0,0,0); background-image: none; border-color: rgba(0,0,0,0); border-width: 0; }
.rr-ui .prism-surface:hover, .rr-ui .prism-surface:focus, .rr-ui .prism-surface:active { background-color: rgba(0,0,0,0); border-width: 0; border-color: rgba(0,0,0,0); }
.rr-ui .prism-surface:disabled { background-color: rgba(0,0,0,0); border-width: 0; opacity: .48; }
.prism-caption { position: relative; margin: 0; padding: 0; flex-grow: 1; align-self: stretch; -unity-text-align: middle-center; white-space: normal; color: var(--ivory); }
.btn-primary > .prism-caption { color: var(--navy); }
.btn-danger > .prism-caption { color: var(--danger); }
.prism-surface:disabled > .prism-caption { color: var(--dim); }
.fleet-card > .prism-caption { display: none; }
.btn-icon { justify-content: center; align-items: center; }
.topbar { height: 76px; padding-left: 25px; padding-right: 20px; }
.empire-identity { width: 290px; margin-right: 20px; }
.emblem-name { font-size: 20px; letter-spacing: 1.4px; }
.identity-sub { font-size: 8px; letter-spacing: 1.8px; }
.res { padding: 0 24px; }
.res-label { font-size: 10px; }
.res-value { font-size: 23px; }
.res-income { font-size: 12px; }
.btn-icon { width: 36px; height: 36px; min-height: 36px; }
.topbar .btn-icon { margin-left: 4px; margin-right: 4px; }
.time-status { width: 157px; }
.inspector { left: 12px; top: 86px; bottom: 12px; width: 460px; padding: 30px 28px 24px 28px; }
.h-display { font-size: 34px; letter-spacing: .3px; }
.eyebrow { font-size: 11px; letter-spacing: 1.7px; }
.subtitle { font-size: 15px; margin-bottom: 19px; }
.kit-tabs { margin-top: 0; margin-bottom: 12px; border-bottom-width: 2px; }
.kit-tab { flex-basis: auto; flex-direction: row; justify-content: center; align-items: center; font-size: 13px; padding: 12px 2px; min-height: 48px; margin-right: 8px; }
.kit-tab-last { margin-right: 0; }
.kit-tab .tab-label { margin-left: 7px; flex-shrink: 0; white-space: nowrap; }
.kit-section { margin-top: 16px; margin-bottom: 10px; }
.kit-section .h-section { font-size: 11px; color: var(--ink); }
.outliner .kit-section .h-section { color: var(--accent); }
.data-row { min-height: 44px; padding: 9px 0; align-items: center; }
.data-row .small { font-size: 14px; }
.data-icon { margin-right: 16px; }
.data-value { font-size: 16px; -unity-font-style: normal; }
.development-meter { margin: 0 10px; flex-grow: 1; max-width: 120px; }
.development-segment { height: 8px; flex-grow: 1; margin: 0 2px; background-color: var(--line-light); }
.development-segment-on { background-color: var(--accent); }
.yield-grid { padding: 8px 0 12px 0; border-bottom-width: 1px; border-bottom-color: var(--line); align-items: stretch; }
.yield-cell { flex-grow: 1; flex-basis: 0; padding: 0 10px; border-right-width: 1px; border-right-color: var(--line); align-items: center; }
.yield-cell-last { border-right-width: 0; }
.yield-cell .small { font-size: 12px; margin-left: 6px; }
.yield-number { color: var(--ink); font-size: 24px; -unity-font-style: bold; margin-top: 8px; }
.orbit-status { align-items: flex-start; padding-top: 4px; }
.orbit-copy { flex-grow: 1; flex-shrink: 1; margin-left: 16px; }
.orbit-title { font-size: 18px; -unity-font-style: bold; color: var(--ink); margin-bottom: 5px; }
.orbit-copy .small { font-size: 14px; }
.dossier-footer { padding-top: 14px; margin-top: 14px; border-top-width: 0; }
.dossier-footer .btn { min-height: 50px; font-size: 15px; }
.command-dock { left: 476px; height: auto; min-height: 270px; padding-top: 6px; }
.command-body { flex-shrink: 0; }
.outliner { width: 45%; padding: 0 22px 16px 22px; }
.outliner .kit-section { margin-top: 16px; margin-bottom: 16px; }
.fleet-card { width: 246px; padding: 16px; margin-right: 12px; justify-content: space-between; }
.fleet-card .item-title { font-size: 16px; }
.fleet-count { font-size: 17px; }
.fleet-status { font-size: 11px; letter-spacing: .8px; }
.fleet-location { margin-top: 6px; }
.fleet-location .item-sub { margin-left: 10px; margin-top: 0; font-size: 14px; }
.inspector-actions { padding: 24px 32px 28px 32px; margin: 6px 10px 12px 0; }
.command-title { font-size: 25px; }
.command-info .small { font-size: 14px; }
/* Command controls keep a deliberate size; free height belongs to the panel. */
.command-info .btn { height: 46px; min-height: 46px; flex-grow: 0; margin: 16px 0 0 0; font-size: 16px; padding: 7px 28px 7px 16px; }
.command-info { align-self: center; }
.command-info > .small { margin: 6px 0 0 0; padding: 0; }
.command-buttons { margin-top: 16px; align-items: center; }
.command-buttons .btn { margin-top: 0; }
.command-buttons .btn-primary { flex-grow: 1; flex-basis: 0; min-width: 0; }
.command-buttons .command-secondary { margin-left: 12px; min-width: 82px; }
.command-info .command-hint { margin-top: 12px; }
.battle-actions .btn { margin-left: 4px; margin-right: 4px; }
.project-icon { margin-right: 12px; }
.command-body > .ship-portrait { border-right-width: 1px; border-right-color: var(--line-light); padding-right: 16px; }
.ship-portrait { width: 175px; height: 150px; margin-right: 20px; }
.ship-portrait-small { width: 110px; height: 76px; margin-right: 10px; }
.item > .ship-portrait-small { width: 100%; height: 82px; }
.context-strip { top: 111px; left: 502px; width: 340px; }
.context-title { font-size: 28px; }
.ticker { top: 103px; right: 22px; width: 386px; padding: 13px 18px; }
.ticker-line { font-size: 13px; }
.strategy-toasts { left: 500px; right: 420px; top: 200px; }
.strategy-hint { left: 500px; bottom: 286px; }
.btn-primary { padding-right: 30px; }
.modal { padding: 30px; }
.battle-left, .battle-right { padding: 23px; }
/* Reserve the hull/status column while long ship names wrap within the roster. */
.unit-card .unit-name { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; padding: 0; white-space: normal; }
.unit-card .unit-status { flex-shrink: 0; margin: 0 0 0 10px; padding: 0; white-space: nowrap; }
.cost-value .num { font-size: 16px; }
.compact .topbar { height: 72px; padding-left: 16px; padding-right: 12px; }
.compact .empire-identity { width: 214px; margin-right: 6px; }
.compact .emblem-name { font-size: 15px; }
.compact .res { padding-left: 10px; padding-right: 10px; }
.compact .res-value { font-size: 18px; }
.compact .res-label { font-size: 8px; }
.compact .res-income { font-size: 10px; }
.compact .btn-icon { width: 30px; height: 30px; min-height: 30px; }
.compact .time-status { width: 138px; }
.compact .inspector { left: 8px; top: 80px; bottom: 8px; width: 310px; padding: 22px 19px 17px 19px; }
.compact .h-display { font-size: 26px; }
.compact .subtitle { font-size: 13px; margin-bottom: 12px; }
.compact .eyebrow { font-size: 9px; }
.compact .kit-tab { font-size: 11px; min-height: 40px; padding: 9px 0; }
.compact .kit-tab .tab-label { margin-left: 4px; white-space: nowrap; }
.compact .kit-section { margin-top: 16px; margin-bottom: 10px; }
.compact .kit-section .h-section { font-size: 10px; letter-spacing: 1px; }
.compact .data-row { min-height: 40px; padding-top: 9px; padding-bottom: 9px; }
.compact .data-row .small { font-size: 12px; }
.compact .data-icon { margin-right: 9px; }
.compact .data-value { font-size: 13px; }
.compact .development-meter { max-width: 75px; margin: 0 6px; }
.compact .development-segment { height: 6px; margin: 0 1px; }
.compact .yield-cell { padding-left: 4px; padding-right: 4px; }
.compact .yield-cell .small { font-size: 10px; margin-left: 4px; }
.compact .yield-number { font-size: 20px; }
.compact .orbit-copy { margin-left: 10px; }
.compact .orbit-copy .small { font-size: 12px; }
.compact .orbit-title { font-size: 15px; }
.compact .dossier-footer { padding-top: 10px; margin-top: 8px; }
.compact .dossier-footer .btn { min-height: 39px; font-size: 13px; }
.compact .command-dock { left: 326px; height: auto; min-height: 220px; }
.compact .outliner { width: 43%; padding-left: 14px; padding-right: 14px; padding-bottom: 12px; }
.compact .fleet-card { width: 184px; padding: 12px; }
.compact .fleet-card .item-title { font-size: 13px; }
.compact .fleet-count { font-size: 13px; }
.compact .fleet-status { font-size: 9px; }
.compact .fleet-location .item-sub { font-size: 12px; }
.compact .ship-portrait { width: 100px; height: 112px; margin-right: 12px; }
.compact .ship-portrait-small { width: 70px; height: 54px; margin-right: 6px; }
.compact .item > .ship-portrait-small { width: 100%; height: 60px; }
.compact .inspector-actions { margin-right: 8px; margin-bottom: 8px; padding: 20px 24px 24px 24px; }
.compact .command-title { font-size: 19px; }
.compact .command-info .small { font-size: 12px; }
.compact .command-info .btn { height: 40px; min-height: 40px; font-size: 13px; margin-top: 12px; }
.compact .command-buttons { margin-top: 12px; }
.compact .command-buttons .btn { margin-top: 0; }
.compact .command-buttons .command-secondary { min-width: 66px; }
.compact .command-info .command-hint { margin-top: 8px; }
.compact .context-strip { left: 344px; top: 102px; width: 260px; }
.compact .ticker { width: 310px; top: 96px; right: 18px; }
.compact .strategy-toasts { left: 340px; right: 340px; }
.compact .strategy-hint { left: 340px; bottom: 236px; }
.compact .cost-value { margin-right: 12px; }
.compact .cost-value .num { font-size: 14px; }
.compact .modal { padding: 24px; }

/* Command-console preferences: fixed header/footer, independently scrolling content. */
.settings-console { height: 870px; max-height: 90%; }
.settings-console .modal-title { margin-top: 8px; margin-bottom: 4px; }
.settings-console .subtitle { margin-bottom: 14px; }
.settings-tabs { flex-direction: row; flex-shrink: 0; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.settings-tabs .btn { flex-grow: 1; margin-right: 8px; min-height: 42px; }
.settings-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.settings-page { padding-right: 16px; padding-bottom: 12px; }
.settings-page .kit-section { margin-top: 14px; margin-bottom: 6px; }
.setting-row { flex-direction: row; align-items: center; flex-shrink: 0; padding: 8px 4px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.setting-range { flex-direction: column; align-items: stretch; }
.setting-copy { flex-grow: 1; flex-shrink: 1; margin-right: 18px; }
.setting-title { font-size: 17px; color: var(--ink); -unity-font-style: bold; }
.setting-hint { font-size: 13px; color: var(--ink-muted); white-space: normal; margin-top: 4px; }
.setting-value { font-size: 17px; color: var(--accent-ink); -unity-font-style: bold; min-width: 58px; -unity-text-align: middle-right; }
.setting-state { font-size: 12px; color: var(--accent-ink); width: 32px; -unity-text-align: middle-right; }
.setting-switch { width: 48px; height: 36px; margin: 0 0 0 10px; }
.setting-switch .unity-toggle__input { justify-content: center; }
.setting-switch .unity-toggle__checkmark { width: 26px; height: 26px; background-color: var(--paper); border-width: 1px; border-color: var(--accent-ink); border-radius: 3px; }
.setting-switch:checked .unity-toggle__checkmark { background-color: var(--accent); }
.setting-switch:focus .unity-toggle__checkmark { border-width: 3px; }
.setting-slider { height: 24px; margin: 4px 6px 0 6px; }
.setting-slider .unity-base-slider__tracker { height: 4px; background-color: var(--line); border-width: 0; }
.setting-slider .unity-base-slider__dragger { width: 14px; height: 22px; background-color: var(--accent-ink); border-width: 2px; border-color: var(--paper); border-radius: 2px; }
.setting-slider:focus .unity-base-slider__dragger { border-color: var(--accent); }
.settings-footer { flex-direction: row; align-items: center; flex-shrink: 0; border-top-width: 1px; border-top-color: var(--line); padding-top: 14px; }
.settings-footer .btn { min-width: 120px; min-height: 42px; }
.shortcut-row { flex-direction: row; align-items: center; flex-shrink: 0; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.shortcut-key { width: 175px; flex-shrink: 0; color: var(--accent-ink); background-color: var(--accent-soft); padding: 7px 10px; font-size: 14px; -unity-font-style: bold; }
.shortcut-action { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 14px; color: var(--ink); margin-left: 18px; }
.compact .setting-title { font-size: 16px; }
.compact .setting-row { padding-top: 10px; padding-bottom: 10px; }

/* Gameplay hierarchy: telemetry, operational state, then available action. */
.dossier-heading .eyebrow { color: var(--accent-ink); letter-spacing: 2px; }
.dossier-heading .h-display { margin-top: 10px; margin-bottom: 10px; }
.dossier-summary { padding: 16px 18px; margin: 2px 0 8px 0; flex-shrink: 0; }
.summary-status { font-size: 10px; letter-spacing: 1px; color: var(--accent); white-space: normal; }
.summary-warning { color: rgb(255,195,130); }
.summary-metrics { align-items: stretch; margin-top: 9px; }
.summary-cell { flex-grow: 1; flex-basis: 0; min-width: 0; }
.summary-cell-last { padding-left: 14px; border-left-width: 1px; border-left-color: rgba(139,207,252,.22); }
.summary-value { color: rgb(244,250,255); font-size: 27px; white-space: normal; }
.summary-label { color: rgb(157,188,211); font-size: 9px; letter-spacing: 1px; margin-top: 4px; }
.inspector .data-row { min-height: 38px; padding-top: 7px; padding-bottom: 7px; }
.inspector .kit-section { margin-top: 14px; margin-bottom: 9px; }
.yield-grid { background-color: rgba(139,207,252,.12); padding-top: 12px; padding-bottom: 12px; border-bottom-width: 0; }
.yield-number { font-size: 27px; }
.orbit-status { padding: 10px; background-color: rgba(139,207,252,.09); border-left-width: 2px; border-left-color: var(--accent-ink); }
.orbit-title { font-size: 16px; }
.orbit-copy .small { font-size: 13px; }
.readiness-note { margin-top: 8px; margin-bottom: 2px; font-size: 12px; }
.roster-item { padding: 10px; margin-top: 5px; background-color: rgba(139,207,252,.09); border-left-width: 2px; border-left-color: var(--line); }
.roster-flagship { border-left-color: var(--accent-ink); background-color: rgba(139,207,252,.19); }
.roster-body { align-items: center; }
.roster-item .ship-portrait-small { width: 106px; height: 73px; margin-right: 10px; }
.roster-info { min-width: 0; margin-left: 0; }
.roster-info .item-title { font-size: 16px; white-space: normal; margin-bottom: 3px; }
.roster-info .item-sub { font-size: 10px; letter-spacing: .7px; margin-top: 0; }
.roster-health { align-items: center; margin-top: 8px; margin-bottom: 4px; }
.roster-health .small { font-size: 9px; letter-spacing: .8px; }
.roster-hull { font-size: 12px; color: var(--ink); }
.roster-info .bar { height: 3px; margin-top: 0; }
.fleet-card { padding: 13px 15px; }
.fleet-selection { font-size: 8px; letter-spacing: 1.3px; color: var(--muted); margin-bottom: 6px; }
.fleet-card-selected .fleet-selection { color: var(--accent); }
.fleet-card .item-title { flex-shrink: 1; white-space: normal; font-size: 15px; }
.fleet-card .fleet-count { font-size: 18px; }
.fleet-card .ship-portrait-small { width: 96px; height: 67px; }
.fleet-location { padding-top: 7px; border-top-width: 1px; border-top-color: rgba(139,207,252,.2); }
.fleet-location .item-sub { flex-shrink: 1; white-space: normal; font-size: 12px; }
.fleet-status { font-size: 10px; }
.project-card { padding: 14px; margin-top: 7px; border-left-width: 3px; }
.project-head { align-items: center; }
.project-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.project-head .ship-portrait-small { width: 106px; height: 64px; margin-right: 10px; }
.project-copy .item-title { font-size: 17px; white-space: normal; }
.project-meta { font-size: 10px; color: var(--accent-ink); letter-spacing: .8px; margin-top: 6px; }
.project-ability { padding-top: 7px; margin-top: 7px; border-top-width: 1px; border-top-color: var(--line); }
.project-cost { padding-top: 10px; margin-top: 8px; border-top-width: 1px; border-top-color: var(--line); }
.command-title { font-size: 26px; margin: 0 0 4px 0; padding: 0; }
.command-info .cost-row { margin-top: 9px; margin-bottom: 3px; }
.res-income { font-size: 11px; }
.compact .dossier-summary { padding: 12px; margin-bottom: 5px; }
.compact .summary-value { font-size: 21px; }
.compact .summary-status { font-size: 9px; }
.compact .summary-label { font-size: 8px; letter-spacing: .5px; }
.compact .summary-cell-last { padding-left: 8px; }
.compact .roster-item { padding: 8px; }
.compact .roster-item .ship-portrait-small { width: 65px; height: 58px; margin-right: 8px; }
.compact .roster-info .item-title { font-size: 13px; }
.compact .roster-info .item-sub { font-size: 9px; letter-spacing: .2px; }
.compact .fleet-selection { font-size: 7px; margin-bottom: 4px; }
.compact .fleet-card { padding: 10px; }
.compact .fleet-card .ship-portrait-small { width: 64px; height: 47px; }
.compact .fleet-card .fleet-count { font-size: 14px; }
.compact .fleet-location { margin-top: 3px; padding-top: 5px; }
.compact .fleet-location .item-sub { font-size: 11px; }
.compact .project-card { padding: 10px; }
.compact .project-head .ship-portrait-small { width: 70px; height: 53px; }
.compact .project-copy .item-title { font-size: 14px; }
.compact .project-meta { font-size: 9px; }
.compact .orbit-status { padding: 8px; }
.compact .orbit-copy { margin-left: 8px; }
.compact .orbit-copy .small { font-size: 12px; }

/* Keep the visual lead compact enough for actionable information below it. */
.dossier-summary { padding: 12px 16px; }
.summary-status { margin: 0; padding: 0; }
.summary-metrics { margin-top: 7px; }
.summary-value { margin: 0; padding: 0; height: 34px; -unity-text-align: middle-left; white-space: nowrap; }
.summary-label { margin: 2px 0 0 0; padding: 0; height: 14px; }
.roster-info .item-title, .roster-info .item-sub, .roster-hull, .roster-health .small { margin: 0; padding: 0; }
.roster-health { margin-top: 6px; margin-bottom: 3px; }
.project-copy .item-title, .project-meta { padding: 0; margin: 0; }
.project-meta { margin-top: 4px; }
.compact .dossier-heading .h-display { margin-top: 5px; margin-bottom: 5px; }
.compact .dossier-summary { padding: 10px 12px; }
.compact .summary-value { height: 29px; font-size: 20px; }
.compact .summary-label { height: 12px; }
